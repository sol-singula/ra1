local Assert = require("./mock/Assert")
local Engine = require("./mock/Engine")

local test, eq = Assert.test, Assert.eq

test("now is the server time and follows the virtual clock", function()
	local engine = Engine.new({ now = 1000 })
	local Clock = engine:require(engine:module("Shared/Clock"))
	eq(Clock.now(), 1000)
	engine:advance(12.5)
	eq(Clock.now(), 1012.5)
end)

test("utcDay at day boundaries", function()
	local engine = Engine.new()
	local Clock = engine:require(engine:module("Shared/Clock"))
	eq(Clock.utcDay(0), 0)
	eq(Clock.utcDay(86399), 0)
	eq(Clock.utcDay(86399.999), 0)
	eq(Clock.utcDay(86400), 1)
	eq(Clock.utcDay(86400 * 20000 - 1), 19999)
	eq(Clock.utcDay(86400 * 20000), 20000)
end)

test("hourStart at hour boundaries", function()
	local engine = Engine.new()
	local Clock = engine:require(engine:module("Shared/Clock"))
	eq(Clock.hourStart(0), 0)
	eq(Clock.hourStart(3599), 0)
	eq(Clock.hourStart(3599.9), 0)
	eq(Clock.hourStart(3600), 3600)
	eq(Clock.hourStart(1_760_000_000), 1_759_996_800)
	eq(Clock.hourStart(1_759_996_800), 1_759_996_800)
end)
