{
  "name": "SnipeANoob",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 28
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
