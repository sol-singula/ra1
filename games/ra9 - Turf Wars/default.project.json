{
  "name": "TurfWars",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "ClockTime": 14
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "Gravity": 196.2
      },
      "Terrain": {
        "$properties": {
          "Decoration": false
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 3,
        "MaxPlayers": 40
      }
    },
    "Teams": {
      "$className": "Teams"
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5,
        "CameraMinZoomDistance": 0.5,
        "EnableMouseLockOption": false,
        "GameSettingsAvatar": "R15",
        "CharacterWalkSpeed": 18,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 7.5,
        "DevCameraOcclusionMode": "Invisicam"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/character/Health.server.lua"
        }
      }
    }
  }
}
